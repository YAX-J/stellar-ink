<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.stellarink</groupId>
        <artifactId>stellar-ink-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ai-service</artifactId>
    <description>AI 业务服务 - 对浏览器的 /ai/** 出口：鉴权复核、配额、审计与 Python 调用编排</description>

    <dependencies>
        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- 数据库：AI 域自己的 ai_* 表（模型配置、评测数据），不碰业务表 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-starter</artifactId>
        </dependency>

        <!-- 服务注册与配置 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- Sa-Token：服务内防御性复核（主门槛在网关，M1 接入路由） -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-jwt</artifactId>
        </dependency>

        <!-- 公共组件 -->
        <dependency>
            <groupId>com.stellarink</groupId>
            <artifactId>shared-model</artifactId>
        </dependency>
        <dependency>
            <groupId>com.stellarink</groupId>
            <artifactId>common-core</artifactId>
        </dependency>

        <!-- Java → content-service 内部契约（RAG 语料读取：文章/笔记 → 投影表） -->
        <dependency>
            <groupId>com.stellarink</groupId>
            <artifactId>stellar-ink-content-client</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Java → Python 内部客户端契约（M0 只冻结契约，M1 接线启用） -->
        <dependency>
            <groupId>com.stellarink</groupId>
            <artifactId>stellar-ink-ai-client</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 接口文档 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 统一响应体里有 LocalDateTime，springdoc 初始化时直接用 JavaTimeModule。
             ⚠️ **不能加 scope=test**（踩过一次，代价是服务直接起不来）：
             它曾经被写成 test 依赖，理由是「切片测试里没有完整的 Jackson 自动配置」——
             理由本身没错，但同一个坐标在**运行期**也是必需的：
             test 依赖不进 fat jar，于是启动时 springdoc 报
             NoClassDefFoundError: JavaTimeModule，ai-service 连端口都没监听起来，
             而现象只是 /ai/** 全部 503，看起来像「服务没起」而不是「依赖范围写错」。
             user-service / content-service 没显式声明它，是从 starter 传递拿到的运行期依赖。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- 内存库：让「模型配置真能落库」这条链路在测试里跑起来（含 @Mapper 扫描与加密列），
             不需要开发机有 MySQL；生产仍用 MySQL，见 application-{dev,prod}.yml -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>ai-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.stellarink.ai.AiServiceApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
