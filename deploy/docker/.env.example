# =============================================================================
# 星笺 STELLAR INK 生产部署环境变量
# 用法：在同目录复制为 .env 并填写实际值（cp .env.example .env）
#       .env 已被 .gitignore / .dockerignore 排除，严禁入库
#
# 【重要】以下四项为「必填、无默认值」，留空会导致 docker compose 直接报错退出
#        （这是刻意设计的 fail-safe：宁可起不来，也不要默认放开）：
#          MYSQL_ROOT_PASSWORD / MYSQL_PASSWORD / SA_TOKEN_JWT_SECRET / GATEWAY_CORS_ORIGINS
# =============================================================================

# —— MySQL（本编排内的 mysql 容器，容器间用服务名 mysql 访问）——
# 若改用云数据库/宿主机已有实例：MYSQL_HOST 填对应地址（宿主机服务用 host.docker.internal）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=stellar_ink
# 业务服务使用的专用账号（mysql 容器首次启动时按下面两项自动创建）
MYSQL_USER=stellar
MYSQL_PASSWORD=
# root 口令：只在运维时用（备份脚本 mysqldump、手工导入 SQL）
MYSQL_ROOT_PASSWORD=

# —— Redis（本编排内的 redis 容器）——
REDIS_HOST=redis
REDIS_PORT=6379
# 容器未启用认证（仅在编排网络内可达，不发布端口）时留空
REDIS_PASSWORD=
REDIS_DATABASE=0

# —— Sa-Token JWT 签名密钥（必填，网关与业务服务必须一致）——
# 生成方式：openssl rand -base64 48
# 切勿使用仓库中 dev 配置的默认值：prod 下 common-core 的 SecretGuard 会拒绝启动
# ⚠️ 生产与测试环境必须使用不同的密钥（Sa-Token 只验签、不看环境，共用密钥等于两边令牌互通）
SA_TOKEN_JWT_SECRET=

# —— Nacos（本编排内的 nacos 容器，单机模式 + 内置 Derby）——
NACOS_ADDR=nacos:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
# 下面三项只在你想改默认值时填（Nacos 未对公网暴露，默认值可用）
# 生成 NACOS_AUTH_TOKEN：openssl rand -base64 48
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=

# —— 网关 CORS 允许的来源（必填，无默认值）——
# 前端经 Nginx 同源反代后浏览器不涉及 CORS，此项仅供直连网关调用时使用。
# 必须填具体域名（多个用逗号分隔），不要填 *：
#   GATEWAY_CORS_ORIGINS=https://www.example.com,https://example.com
GATEWAY_CORS_ORIGINS=

# —— 头像存储（可选）——
# STORAGE_TYPE=local（默认，用下方的 Docker 卷存头像文件）或 cos（腾讯云对象存储，推荐生产使用）
# 用 cos 时下面四项必填；改回 local 即回滚（历史 COS URL 会被安全忽略，不会误删本地文件）
STORAGE_TYPE=local
COS_BUCKET=
COS_REGION=
# 对外访问基址：填 CDN 域名（如 https://cdn.example.com）。
# ⚠️ 必须是「浏览器能访问到」的地址；留空则用 COS 默认域名。
# 切勿填内网端点或 localhost —— 会导致图片全站 404、前端降级成底字头像。
COS_PUBLIC_BASE=
# CAM 子账号密钥（不是主账号密钥！），仅通过环境变量注入，绝不写入仓库/Nacos
COS_SECRET_ID=
COS_SECRET_KEY=

# —— 对外端口 ——
# :80 只做健康检查与到 https 的 301；:443 承载站点（Cloudflare 回源，证书放置见 README 第五节）
WEB_PORT=80
WEB_HTTPS_PORT=443
GATEWAY_PORT=8080
# Nacos 控制台：只绑宿主机回环。用 SSH 隧道访问：ssh -L 8848:127.0.0.1:8848 <服务器>
NACOS_PORT=8848

# —— 本地开发用的宿主机回环端口 ——
# MySQL / Redis / Qdrant 只绑宿主机 127.0.0.1（公网与安全组都碰不到），
# 本地开发经 SSH 隧道访问；一条命令把全部端口开出来：
#   ssh -L 3306:127.0.0.1:3306 -L 6379:127.0.0.1:6379 -L 6333:127.0.0.1:6333 \
#       -L 8080:127.0.0.1:8080 -L 8848:127.0.0.1:8848 ubuntu@<服务器IP>
MYSQL_BIND_PORT=3306
REDIS_BIND_PORT=6379
QDRANT_BIND_PORT=6333
