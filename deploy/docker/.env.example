# =============================================================================
# 星笺 STELLAR INK 生产部署环境变量
# 用法：在同目录复制为 .env 并填写实际值（cp .env.example .env）
#       .env 已被 .gitignore / .dockerignore 排除，严禁入库
#
# ── 字段按「留空的后果」分四级，不按重要性分 ──────────────────────────────
#
# ① 必填：缺失时 `docker compose` 直接报错退出（刻意 fail-safe，想跳过都不行）
#      MYSQL_ROOT_PASSWORD / MYSQL_PASSWORD / SA_TOKEN_JWT_SECRET / GATEWAY_CORS_ORIGINS
#      / GRAFANA_ADMIN_PASSWORD
#    —— compose 里写的是 `${VAR:?请在 deploy/docker/.env 中设置 …}`。
#
# ② 有默认值，但**生产必须改**：默认值是**写在仓库里的公开字符串**，凡读到仓库的人都知道
#      NACOS_AUTH_TOKEN / NACOS_AUTH_IDENTITY_KEY / NACOS_AUTH_IDENTITY_VALUE / NACOS_PASSWORD
#    —— 这与 SA_TOKEN_JWT_SECRET 的教训同源：公开的默认密钥等于没有密钥。
#       本项目在 JWT 上已经栽过一次（`JwtSecretPolicy` 就是为此而写），Nacos 这四项同理。
#       它们的后果比 JWT 小（Nacos 只绑宿主机回环、端口不发布），但没有任何理由留着不改。
#
# ③ 按需填：选了对应能力才必填
#      STORAGE_TYPE=cos 时 → COS_BUCKET / COS_REGION / COS_SECRET_ID / COS_SECRET_KEY
#                            （COS_PUBLIC_BASE 强烈建议填，留空会退化成 COS 默认域名）
#      REDIS_PASSWORD → Redis 只在编排网络内且不发布端口时可留空
#
# ④ 一般不用改：端口与容器间地址，默认值都已面向本编排写好
#      MYSQL_HOST/PORT/DB/USER、REDIS_HOST/PORT/DATABASE、NACOS_ADDR/USERNAME、
#      MYSQL_BIND_PORT、REDIS_BIND_PORT、QDRANT_BIND_PORT、
#      WEB_PORT / WEB_HTTPS_PORT / GATEWAY_PORT / NACOS_PORT
#
# ── ⚠️ 本编排**不含 AI 栈** ──────────────────────────────────────────────
# 它部署的是「博客整栈」：Nacos / MySQL / Redis / Qdrant + 网关 + user、content 两个业务服务
# + 前端 Nginx。**ai-service(:8107) 与 Python(:8200) 不在其中**，要单独起
# （见 docs/architecture/README.md 与 stellar-ink-ai/README.md）。
#
# 所以 AI 需要的三个环境变量**不在本文件里**，它们各自注入到那两个进程：
#   AI_INTERNAL_SECRET    Java ↔ Python 内部请求签名，**两侧必须同一个值**。
#                         缺失时 Java 侧拒绝签名、Python 侧拒绝校验 —— 所有 AI 能力直接不可用
#                         （表现为 401「内部请求校验失败」，与登录无关）。
#   AI_SECRET_MASTER_KEY  模型 API Key 的 AES-256-GCM 主密钥。缺失则面板里配的模型解不开，
#                         表现为「角色 X 尚未配置模型」这类看起来像"没配"的错误。
#   AI_PYTHON_BASE_URL    仅容器化时需要（同机直跑默认 http://127.0.0.1:8200）。
# 两个密钥都用 `openssl rand -base64 48` 生成；本机开发由 deploy/scripts/read-ai-env.bat
# 从 stellar-ink-ai/.env 读出来注入 Java 侧。
#
# ── 填完自检 ────────────────────────────────────────────────────────────
#   docker compose config >/dev/null     # 语法 + 必填项一次验完，不会真的启动容器
# =============================================================================

# —— MySQL（本编排内的 mysql 容器，容器间用服务名 mysql 访问）——
# 若改用云数据库/宿主机已有实例：MYSQL_HOST 填对应地址（宿主机服务用 host.docker.internal）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=stellar_ink
# 业务服务使用的专用账号（mysql 容器首次启动时按下面两项自动创建）
MYSQL_USER=stellar
MYSQL_PASSWORD=
# root 口令：只在运维时用（备份脚本 mysqldump、手工导入 SQL）
MYSQL_ROOT_PASSWORD=

# —— Redis（本编排内的 redis 容器）——
REDIS_HOST=redis
REDIS_PORT=6379
# 容器未启用认证（仅在编排网络内可达，不发布端口）时留空
REDIS_PASSWORD=
REDIS_DATABASE=0

# —— Sa-Token JWT 签名密钥（必填，网关与业务服务必须一致）——
# 生成方式：openssl rand -base64 48
# 切勿使用仓库中 dev 配置的默认值：prod 下 common-core 的 SecretGuard 会拒绝启动
# ⚠️ 生产与测试环境必须使用不同的密钥（Sa-Token 只验签、不看环境，共用密钥等于两边令牌互通）
SA_TOKEN_JWT_SECRET=

# —— Nacos（本编排内的 nacos 容器，单机模式 + 内置 Derby）——
NACOS_ADDR=nacos:8848
NACOS_USERNAME=nacos
# ⚠️ 下面四项**生产必须改**（不是"想改才改"）：默认值全部是写在 docker-compose.yml 里的
# 公开字符串（NACOS_AUTH_TOKEN 默认就是 Nacos 官方示例的 SecretKey0123…），
# 等于把控制台口令连同身份密钥一起公开。生成：openssl rand -base64 48
NACOS_PASSWORD=nacos
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=

# —— 网关 CORS 允许的来源（必填，无默认值）——
# ⚠️ 这是「**实际访问来源**的完整清单」，不是只管跨域调用：浏览器发 POST 一定带 `Origin`，
#    网关比对失败就直接回 403（症状与定位见 docs/troubleshooting.md §2.5）。
#    所以**每一种访问方式都要列进来**，比如：
#      GATEWAY_CORS_ORIGINS=https://www.example.com,https://example.com   ← 生产域名（经 Cloudflare）
#      ...,https://124.221.158.32                                         ← 用 IP 直连时（测试机常这样）
#      ...,http://124.221.158.32:8088                                     ← 用 HTTP 端口访问时（非默认端口要写全）
#    必须填具体来源（逗号分隔），**不要填 `*`**：本项目响应里带 `Set-Cookie: Authorization=…`，
#    填 `*` 会使 allowCredentials 失效（或直接启动报错），等于放开任意站点携带登录态发请求。
#    改完必须**重建网关容器**：docker compose up -d --no-deps gateway（它是环境变量，restart 不够）。
GATEWAY_CORS_ORIGINS=

# —— 头像存储（可选）——
# STORAGE_TYPE=local（默认，用下方的 Docker 卷存头像文件）或 cos（腾讯云对象存储，推荐生产使用）
# 用 cos 时下面四项必填；改回 local 即回滚（历史 COS URL 会被安全忽略，不会误删本地文件）
STORAGE_TYPE=local
COS_BUCKET=
COS_REGION=
# 对外访问基址：填 CDN 域名（如 https://cdn.example.com）。
# ⚠️ 必须是「浏览器能访问到」的地址；留空则用 COS 默认域名。
# 切勿填内网端点或 localhost —— 会导致图片全站 404、前端降级成底字头像。
COS_PUBLIC_BASE=
# CAM 子账号密钥（不是主账号密钥！），仅通过环境变量注入，绝不写入仓库/Nacos
COS_SECRET_ID=
COS_SECRET_KEY=

# —— 对外端口 ——
# :80 只做健康检查与到 https 的 301；:443 承载站点（Cloudflare 回源，证书放置见 README 第五节）
WEB_PORT=80
WEB_HTTPS_PORT=443
GATEWAY_PORT=8080
# Nacos 控制台：只绑宿主机回环。用 SSH 隧道访问：ssh -L 8848:127.0.0.1:8848 <服务器>
NACOS_PORT=8848

# —— 本地开发用的宿主机回环端口 ——
# MySQL / Redis / Qdrant / 网关 / Grafana 只绑宿主机 127.0.0.1（公网与安全组都碰不到），
# 本地开发经 SSH 隧道访问；一条命令把全部端口开出来：
#   ssh -L 3306:127.0.0.1:3306 -L 6379:127.0.0.1:6379 -L 6333:127.0.0.1:6333 \
#       -L 8080:127.0.0.1:8080 -L 8848:127.0.0.1:8848 -L 3000:127.0.0.1:3000 ubuntu@<服务器IP>
MYSQL_BIND_PORT=3306
REDIS_BIND_PORT=6379
QDRANT_BIND_PORT=6333

# —— 可观测性（Prometheus + Grafana）——
# ⚠️ Prometheus 与 Alertmanager **不发布任何端口**（Prometheus 用服务名从编排内网抓四个 Java 服务，
#    见 observability/prometheus.yml）。只有 Grafana 绑宿主机回环，用 SSH 隧道看：
#      ssh -L 3000:127.0.0.1:3000 ubuntu@<服务器>
#    刻意不发布 Prometheus 的 9090：它没有鉴权，暴露公网等于把全部运行指标连同
#    「哪个接口在报错、AI 花了多少钱」一起公开。
GRAFANA_PORT=3000
# Grafana 管理员口令（必填）。Grafana 默认账号是 admin；这里同时关掉了匿名访问与自助注册
# （见 docker-compose.yml 的 GF_AUTH_ANONYMOUS_ENABLED / GF_USERS_ALLOW_SIGN_UP）。
GRAFANA_ADMIN_PASSWORD=

# —— AI 栈（ai-service :8107 与 Python :8200；它们已包含在本编排里）——
# 内部请求签名密钥：Java 与 Python 侧**必须逐字一致**。缺失或两边不一致时，
# 所有 AI 能力直接不可用（表现为 401「内部请求校验失败」，与登录状态无关）。
# 生成：openssl rand -base64 48
AI_INTERNAL_SECRET=
# 模型 API Key 的 AES-256-GCM 主密钥：base64 解码后必须**恰好 32 字节**（不是 32 个字符）。
# 生成：openssl rand -base64 32
# ⚠️ 换掉它之后必须在面板里**重新保存一次模型配置** —— 旧密文是用旧主密钥加的，换钥匙就解不开。
AI_SECRET_MASTER_KEY=
# Nacos 命名空间：必须与 gateway/user/content 用同一个，否则 ai-service 注册到别的空间、
# 网关（lb://ai-service）永远发现不到它。默认值是 prod 档一直用的那个。
NACOS_NAMESPACE=140e3d39-2520-4d07-a08a-f4b2451109c8
# Qdrant 地址（Python 侧用；容器里访问宿主 Qdrant 只能走 host.docker.internal）
QDRANT_BASE_URL=http://host.docker.internal:6333
# Python 运行档：dev（保留 /docs，便于排错）/ prod（关掉 /docs 与自检接口）
AI_APP_ENV=dev
# dense 检索走向量库（而不是进程内存）：**打开前必须先建索引**，
# 索引里没有的内容检索不到（表现是「没有依据」而不是报错）。
AI_DENSE_STORE_ENABLED=false
