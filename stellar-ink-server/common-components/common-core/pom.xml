<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.stellarink</groupId>
        <artifactId>common-components</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>common-core</artifactId>
    <description>核心基础设施：全局异常处理、链路追踪、MyBatis-Plus 配置、健康检查</description>

    <dependencies>
        <dependency>
            <groupId>com.stellarink</groupId>
            <artifactId>shared-model</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <!-- 参数校验实现（DTO 上的 @NotBlank/@Size 等注解由 shared-model 引入的 API 声明）。
             Spring Boot 2.3 起 web starter 不再传递该依赖，必须显式引入，否则 @Valid 静默失效 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Lettuce 连接池：没有它 `spring.data.redis.lettuce.pool` 全部被忽略，
             RedisLettuceTuningConfig 关掉共享连接后就退化成「每个操作新建一条连接」。
             版本由 spring-boot-dependencies 管理（2.12.0），不要写死。 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <!-- Druid：只为编译 DruidKeepAliveConfig（跨公网连 MySQL 的空闲保活兜底）。
             标 optional —— 业务服务各自已引 druid-spring-boot-starter，这里不重复传递。 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-starter</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
        </dependency>
        <!-- JWT 无状态模式的异常类型（SaJwtException）：只有参与验签的服务才需要，
             因此标 optional —— 这里只为了能编译 SaJwtExceptionAdvice，
             不会传递到 user/content 等模块，消费方引与不引都不会被强制。 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-jwt</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 单元测试（版本由父 pom / spring-boot-dependencies 管理） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
