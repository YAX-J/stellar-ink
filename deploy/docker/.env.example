# =============================================================================
# 星笺 STELLAR INK 生产部署环境变量
# 用法：在同目录复制为 .env 并填写实际值（cp .env.example .env）
#       .env 已被 .gitignore / .dockerignore 排除，严禁入库
#
# 【重要】以下若干项为「必填、无默认值」，留空会导致 docker compose 直接报错退出
#        （这是刻意设计的 fail-safe：宁可起不来，也不要默认放开）：
#          MYSQL_PASSWORD / SA_TOKEN_JWT_SECRET / GATEWAY_CORS_ORIGINS
#          NACOS_AUTH_TOKEN / NACOS_AUTH_IDENTITY_KEY / NACOS_AUTH_IDENTITY_VALUE
# =============================================================================

# —— MySQL（复用宿主机上已有的 mysql 容器，经宿主机映射端口 3306 访问）——
# 如改用云数据库/其他主机，直接换成对应地址即可
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DB=stellar_ink
MYSQL_USER=root
MYSQL_PASSWORD=

# —— Sa-Token JWT 签名密钥（必填，网关与业务服务必须一致）——
# 生成方式：openssl rand -base64 48
# 切勿使用仓库中 dev 配置的默认值：prod 下 common-core 的 SecretGuard 会拒绝启动
SA_TOKEN_JWT_SECRET=

# —— Nacos ——
# 服务端已开启认证（NACOS_AUTH_ENABLE=true），下列账号即服务端凭据。
# 默认口令 nacos/nacos 是公开的弱凭据，首次部署后请通过控制台/API 修改并同步此处。
# 管理台仅绑定宿主机 127.0.0.1，走 SSH 隧道访问：ssh -L 8848:127.0.0.1:8848 <服务器>
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# —— Nacos 服务端鉴权（必填）——
# Nacos 2.2+ 起要求下列两项非默认值，否则服务端拒绝启动。
#   NACOS_AUTH_TOKEN：Base64 字符串，解码后不得少于 32 字节 → openssl rand -base64 48
#   NACOS_AUTH_IDENTITY_KEY / VALUE：自定义的服务端身份键值，任意随机串即可
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=

# —— 网关 CORS 允许的来源（必填，无默认值）——
# 前端经 Nginx 同源反代后浏览器不涉及 CORS，此项仅供直连网关调用时使用。
# 必须填具体域名（多个用逗号分隔），不要填 *：
#   GATEWAY_CORS_ORIGINS=https://www.example.com,https://example.com
GATEWAY_CORS_ORIGINS=

# —— 对外端口 ——
WEB_PORT=80
GATEWAY_PORT=8080
