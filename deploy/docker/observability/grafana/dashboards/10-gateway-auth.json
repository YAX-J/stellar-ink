        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (result) (rate(stellar_auth_revoked_check_total[5m]))",
          "legendFormat": "{{result}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "撤销校验结果分布（ok / revoked / error / timeout）",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "撤销校验耗时的 P95 与 P99（秒，按 le 聚合后取分位）。单次查询带一次重试（间隔 120ms），整体上限 2 秒；稳态下本机到远端 Redis 往返约 36ms、命令超时 500ms，余量充足。P99 逼近 2 秒说明连接池被占满或 Lettuce 正在重连 —— 这正是「莫名其妙 503」与浏览器侧 (canceled) @15s 的来源，配合左边的结果分布与「撤销查询重试次数」一起看。",
      "fieldConfig": {
        "defaults": {
          "color": {
