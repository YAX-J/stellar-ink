# =============================================================================
# 星笺 AI 编排服务（stellar-ink-ai :8200）本地配置
#
# 用法：
#   cd stellar-ink-ai
#   cp .env.example .env      # Windows: copy .env.example .env
#   # 只需填下面「必填」两项，其余留默认即可
#
# ⚠️ `.env` 已被 .gitignore 排除，**绝不入库**；本文件（.env.example）入库，只放占位值。
#
# 关于「改完怎么生效」：
#   本服务**不注册 Nacos**（Python 不参与 Java 服务发现），配置只来自环境变量 + 这份 .env。
#   真实环境变量优先于 .env —— 生产用容器注入，本地才用文件。
#
# 关于「密钥为什么没有默认值」：
#   这是刻意设计的 fail-safe。给一个弱默认值等于让「内网即可冒充」重新成立，
#   因此缺失时相关能力直接拒绝（验签 401 / 解密拒绝），而不是放行或降级。
# =============================================================================

# -----------------------------------------------------------------------------
# 【必填】内部签名密钥 —— 必须与 Java 侧 ai-service 的 AI_INTERNAL_SECRET **逐字一致**
#
# 用途：ai-service（Java）签发 X-AI-* 头，本服务验签。标准串是
#       METHOD \n PATH \n TIMESTAMP_MS \n NONCE \n SHA256_HEX(BODY) \n USER_ID \n ROLE
#       （身份字段也参与签名，否则内网中间人改个 X-AI-User-Id 就能冒充 ADMIN）
#
# 生成：openssl rand -base64 48
# 要求：至少 32 字符，与 Java 侧同口径（两侧都比对长度，短了会拒绝）
# 缺失后果：所有受保护接口（/qa、/writing/*、/agent/ask、/eval/*）一律 401
# -----------------------------------------------------------------------------
AI_INTERNAL_SECRET=

# -----------------------------------------------------------------------------
# 【必填】模型密钥主密钥（AES-256-GCM，base64 的 32 字节）
#
# 用途：解密 ai_provider_config.api_key_cipher（面板里填的模型 API Key 的密文）。
#       必须与 Java 侧 ai-service 的 AI_SECRET_MASTER_KEY **同一把**，
#       否则 Java 加密的密文本服务解不开（报的是「密文格式不对」，很容易误判成表数据坏了）。
#
# 生成：openssl rand -base64 32
# 要求：base64 解码后**恰好 32 字节**（不是 32 个字符）
#
# 现状说明：当前问答 / Copilot / 画像 / Agent 都是离线装配（种子语料 + FakeProvider），
#           还没从 ai_provider_config 读配置，所以**这一项暂时用不到**。
#           但「接入真实 Provider」那一刀之后就必须有，建议现在就与 Java 侧一起设好，
#           免得两边不一致时表现成「密钥填了却报未配置」而排查方向跑偏。
# -----------------------------------------------------------------------------
AI_SECRET_MASTER_KEY=

# -----------------------------------------------------------------------------
# 以下都有可用默认值，本地一般**不需要改**
# -----------------------------------------------------------------------------

# 运行环境：dev / prod / test。影响日志格式与自检严格程度。
# 本地开发保持 dev；prod 下会关掉 /docs 与 /internal/whoami 自检接口
AI_APP_ENV=dev

# 监听端口（仅本机/内网暴露，网关与浏览器都不得直达 8200）
AI_PORT=8200

# 服务名，只出现在日志与健康检查输出里
AI_SERVICE_NAME=stellar-ink-ai

# 日志级别：DEBUG / INFO / WARNING / ERROR
AI_LOG_LEVEL=INFO

# =============================================================================
# 启动方式（本文件是配置，不是启动脚本）
#
#   uv sync
#   uv run uvicorn app.main:app --host 127.0.0.1 --port 8200
#
# 起来之后按顺序验：
#   curl http://127.0.0.1:8200/health            # 本服务探活（公开，不需要签名）
#   curl http://127.0.0.1:8107/ai/health         # Java 出口 → 本服务是否可达（需先起 ai-service）
#   curl http://127.0.0.1:8080/ai/health         # 经网关（前端实际走的路）
#
# 注意：本服务**必须**由 Java 侧带着 X-AI-* 签名头调用。
#       直接用 curl 打 /qa、/writing/*、/agent/ask 会 401，那是正常的（不是配置错了）。
#       非生产环境可用 GET /internal/whoami 验证签名链路（它返回验签后的身份）。
# =============================================================================
