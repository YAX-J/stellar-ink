# 复制到 /etc/stellar-ink/backup.env，chmod 600；systemd 读取。
BACKUP_ROOT=/data/stellar-ink/backups
BACKUP_RECIPIENTS_FILE=/etc/stellar-ink/backup-recipients.txt
BACKUP_REMOTE=
BACKUP_KEEP_DAYS=7
# 宿主机 MySQL 模式才设置下面三项。
# BACKUP_MYSQL_MODE=host
# BACKUP_MYSQL_CNF=/etc/stellar-ink/mysql-backup.cnf
# MYSQL_DB=stellar_ink
