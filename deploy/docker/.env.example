# =============================================================================
# 星笺 STELLAR INK 生产部署环境变量
# 用法：在同目录复制为 .env 并填写实际值（cp .env.example .env）
#       .env 已被 .gitignore / .dockerignore 排除，严禁入库
#
# 【重要】以下三项为「必填、无默认值」，留空会导致 docker compose 直接报错退出
#        （这是刻意设计的 fail-safe：宁可起不来，也不要默认放开）：
#          MYSQL_PASSWORD / SA_TOKEN_JWT_SECRET / GATEWAY_CORS_ORIGINS
# =============================================================================

# —— MySQL（复用宿主机上已有的 mysql 容器，经宿主机映射端口 3306 访问）——
# 如改用云数据库/其他主机，直接换成对应地址即可
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DB=stellar_ink
MYSQL_USER=root
MYSQL_PASSWORD=

# —— Sa-Token JWT 签名密钥（必填，网关与业务服务必须一致）——
# 生成方式：openssl rand -base64 48
# 切勿使用仓库中 dev 配置的默认值：prod 下 common-core 的 SecretGuard 会拒绝启动
SA_TOKEN_JWT_SECRET=

# —— Nacos（复用宿主机 /opt/nacos 中运行的服务）——
# Java 服务位于 Docker 容器内，通过 host-gateway 访问宿主机；Nacos 2.x 需确保 8848/9848 可达。
NACOS_ADDR=host.docker.internal:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# —— 网关 CORS 允许的来源（必填，无默认值）——
# 前端经 Nginx 同源反代后浏览器不涉及 CORS，此项仅供直连网关调用时使用。
# 必须填具体域名（多个用逗号分隔），不要填 *：
#   GATEWAY_CORS_ORIGINS=https://www.example.com,https://example.com
GATEWAY_CORS_ORIGINS=

# —— 对外端口 ——
WEB_PORT=80
GATEWAY_PORT=8080
