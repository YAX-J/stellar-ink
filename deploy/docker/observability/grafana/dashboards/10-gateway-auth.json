    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "error|timeout 的每秒速率，即「撤销校验不可用」直接导致 503 的速率。这条不为 0 时用户看到的 503 是 fail-closed 的预期行为（安全优先，不是服务崩了）；排查方向固定是网关到 Redis 的链路：连接被 NAT 掐断、Lettuce 正在重连、或响应式连接池被占满。注意四个服务必须连同一个 Redis，撤销键由 user-service 写入、网关读取。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 3,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.0001
              }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
